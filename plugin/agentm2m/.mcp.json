{
  "agentm2m": {
    "command": "uvx",
    "args": [
      "--from",
      "${AGENTM2M_ENGINE:-agentm2m==0.3.0}",
      "--with",
      "mcp>=1.2",
      "agentm2m-mcp"
    ],
    "env": {
      "AGENTM2M_LLM": "${AGENTM2M_LLM:-host}",
      "AGENTM2M_URL": "${AGENTM2M_URL:-}",
      "AGENTM2M_API_KEY": "${AGENTM2M_API_KEY:-}",
      "AGENTM2M_PROJECT": "${AGENTM2M_PROJECT:-}"
    }
  }
}
