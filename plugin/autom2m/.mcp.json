{
  "autom2m": {
    "command": "uvx",
    "args": [
      "--from",
      "${AUTOM2M_ENGINE:-autom2m==0.4.0}",
      "--with",
      "mcp>=1.2",
      "autom2m-mcp"
    ],
    "env": {
      "AGENTHOT_LLM": "${AGENTHOT_LLM:-host}",
      "AGENTHOT_URL": "${AGENTHOT_URL:-}",
      "AGENTHOT_API_KEY": "${AGENTHOT_API_KEY:-}",
      "AGENTHOT_PROJECT": "${AGENTHOT_PROJECT:-}"
    }
  }
}
