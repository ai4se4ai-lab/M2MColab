# Copy to .env and edit. Selects the pluggable LLM backend used for @llm
# stochastic bindings (src/agentm2m/config.py). The .env is found by walking
# up from the current directory, then falling back to the repo root; variables
# already set in the shell win.

# One of: ollama | openai | anthropic | mock
LLM_PROVIDER=ollama

# Model tag/name for the selected provider.
# Ollama example tags: qwen3:8b, qwen2.5-coder:7b, llama3.1:8b
LLM_MODEL=qwen3:8b

# --- Ollama (local, default; no API key required) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=

# Sampling / validation
LLM_TEMPERATURE=0.2
LLM_MAX_RESAMPLES=3

# --- Workspace / MCP server (Claude Code plugin) ---
# Backend for a .agentm2m/ workspace. "host" (default) lets Claude fill the
# @llm values; otherwise one of the LLM_PROVIDER values above.
# AGENTM2M_LLM=host
# AGENTM2M_MODEL=
# AGENTM2M_MAX_RESAMPLES=3
# Project directory the MCP server opens (defaults to CLAUDE_PROJECT_DIR, then CWD).
# AGENTM2M_PROJECT_DIR=

# --- AutoM2M evaluation (evaluation/) ---
# These are read before .env is loaded, so export them in the shell
# (e.g. `export AM2M_OLLAMA=...`) rather than relying on this file.
# Ollama endpoint for the experiment runs (a second instance on port 11435).
# AM2M_OLLAMA=http://127.0.0.1:11435
# Generated-token budget per run, applied to every condition; also cited in
# docs/tables/numbers.tex.
# AM2M_BUDGET_OUT=24000
# Python used to execute generated code in the sandbox (defaults to
# .venv-sbx/bin/python, then the current interpreter).
# AM2M_SANDBOX_PY=.venv-sbx/bin/python
# Per-run team workdirs go under $TMPDIR (default /tmp).

# --- Plugin release (plugin/scripts/release.sh; shell env, not read from .env) ---
# Public repo URL (same as --repo-url); required to publish.
# AGENTM2M_REPO_URL=https://github.com/OWNER/REPO
# Set to 1 only after the double-anonymous review is over; publishing is refused otherwise.
# AGENTM2M_ALLOW_PUBLIC=0
