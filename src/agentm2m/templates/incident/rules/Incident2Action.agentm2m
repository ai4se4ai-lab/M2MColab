-- Triage -> Remediation: proposes a RemediationAction for each Incident.
--
-- `self <- @llm(...)` is a Lift binding (agentm2m.engine.lift.LIFT_BINDING_NAME
-- is exactly the string 'self'): its sampled text is parsed as JSON and
-- written onto RemediationAction's EAttributes in one call (name, command,
-- risk_level), rejected -- triggering resample/escalation -- unless every
-- JSON key names a real EAttribute of RemediationAction.
--
-- `dryRun` is a SEPARATE, ordinary stochastic binding, gated by an
-- executable-oracle @check (`passesDryRun`, rules/helpers.py): it does not
-- just parse the sampled script, it actually runs it as a subprocess and
-- only accepts an exit code of 0. Under `--llm mock` this @check always
-- rejects (the mock backend's deterministic fallback text is not a
-- runnable script), so every RemediationAction created by this rule
-- escalates on `dryRun` -- see README.md, "What an escalation means".
module Incident2Action;
create OUT : Actions from IN : Incidents;
uses 'helpers.py';

rule Incident2RemediationAction {
  from i : Incidents!Incident
  to  ra : Actions!RemediationAction (
    id       <- i.id,
    incident <- i,
    self     <- @llm('Respond with a JSON object with exactly the fields name, command, and risk_level describing a recommended remediation action for this incident. risk_level must be one of low, medium, or high.',
                      i.summary),
    dryRun   <- @llm('Write a short Python dry-run script that validates this remediation before it runs; it should print OK and exit 0 if the remediation is safe to apply',
                      i.summary),
    @check dryRun.passesDryRun() )
}
