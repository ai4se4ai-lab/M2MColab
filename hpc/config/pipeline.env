# AutoM2M EMSE study on Nibi — pipeline configuration (sourced by every job).
# submit_pipeline.sh freezes a copy of this file into hpc/logs/<RUN_ID>/ so that
# editing it later never changes a study that is already running.

# ── Slurm ────────────────────────────────────────────────────────────────────
ACCOUNT="${ACCOUNT:-def-mbabaei}"
MAX_REQUEUES="${MAX_REQUEUES:-30}"          # resubmissions per job after hitting its time limit

# ── GPUs (cluster-specific) ──────────────────────────────────────────────────
# Narval: 4 x A100-SXM4 40 GB per node, 48 cores; at most 12 cores per GPU. (Nibi: GPU_TYPE=h100, 80 GB.)
# Compute nodes have no internet on Narval: stage the downloads first with `bash hpc/slurm/stage_offline.sh`.
GPU_TYPE="${GPU_TYPE:-a100}"
CPUS_PER_GPU=12
MEM_PER_GPU_GB=120       # Narval share: 498 GB / 4 GPUs (DeepSeek-Coder-V2, since replaced, needed ~126 GB host RAM on 2 GPUs)
# GPUs per stage (matrix and rq4_repair: per model, column 5 of models.tsv)
GPUS_SETUP=1          # each model is loaded alone at num_ctx 4096
GPUS_RQ2_BUILDER=1    # RQ2_BUILDER_MODEL (7B)
GPUS_RQ4_REF=2        # reference-team model + 32B judge, num_ctx 32768
GPUS_RQ2_LLM=4        # critics 32B + devstral + 7B resident together, num_ctx 32768
GPUS_RQ4_BUILDER=2    # 32B (also the judge), num_ctx 32768, AUX_NUM_PARALLEL slots
GPUS_CODING=2         # coders 32B + devstral, num_ctx 32768
GPUS_SIZING=4         # 90_check_gpu_sizing.sh: each scenario uses the first N of these GPUs

# ── Software ─────────────────────────────────────────────────────────────────
MODULES="StdEnv/2023 python/3.11 arrow/24.0.0"   # arrow provides pyarrow for `datasets`
OLLAMA_VERSION="${OLLAMA_VERSION:-0.30.6}"

# ── Storage (scratch for active work; results are collected to hpc/results/) ─
WORK="${WORK:-${SCRATCH:-$HOME/scratch}/autom2m_hpc}"
OLLAMA_PREFIX="$WORK/opt/ollama-$OLLAMA_VERSION"  # bin/ollama + lib/ollama
OLLAMA_MODELS="${OLLAMA_MODELS:-${SCRATCH:-$HOME/scratch}/.ollama/models}"
HF_HOME="$WORK/hf_cache"
WHEELS="$WORK/wheels"                             # wheels missing from the Alliance wheelhouse
AM2M_DATA="$WORK/data"                            # Who&When clone
NLTK_DATA_DIR="$HOME/.cache/nltk_data"            # the sandbox reads ~/.cache/nltk_data

# ── Subject models (paper Sec. 5.3, "Models") — see models.tsv for sizing ────
MODELS="qwen2.5-coder:7b qwen2.5-coder:32b devstral:24b gemma3:27b granite-code:20b codellama:13b starcoder2:15b"
BENCHES="classeval humanevalplus"
CONDITIONS="single,free,critic,schema,typed_nc,autom2m,typed_ref,single_gate"
SEEDS="1,2,3"
TASKS=""                                          # "" = all 100 ClassEval / 164 HumanEval+ tasks
MATRIX_PASSES=3                                   # extra passes per job to retry runs that ended in "error"

# ── Harness settings ─────────────────────────────────────────────────────────
AM2M_BUILDER=v2                                   # the checked builder (Build, Alg. 3)
# Auxiliary roles (paper: coders Qwen2.5-Coder 32B + Devstral; seeder Gemma 3 27B (replaced DeepSeek-Coder-V2, whose generation stalled under Ollama);
# judge Qwen2.5-Coder 32B; critics "two larger models and one 7B").
AM2M_CODERS="qwen2.5-coder:32b@11,devstral:24b@23"
AM2M_CRITICS="qwen2.5-coder:32b@31,devstral:24b@33,qwen2.5-coder:7b@35"
AM2M_SEEDER="gemma3:27b@41"
AM2M_JUDGE="qwen2.5-coder:32b@51"

# ── Study sizes (paper values) ───────────────────────────────────────────────
RQ1_OURS_N=400                                    # Free/Critic failures coded for RQ1
RQ2_PER_CLASS=60                                  # seeded defects per class (300 total)
RQ2_BUILDER_MODEL="qwen2.5-coder:7b"              # builder ablation + one-example run
RQ2_ABLATION_TASKS="first:40"
RQ4_REF_MODELS="qwen2.5-coder:7b qwen2.5-coder:32b devstral:24b"   # 3 x 200 = 600 injected faults
RQ4_BUILDER_MODEL="qwen2.5-coder:32b"                              # 200 faults on builder teams
RQ4_PER_CLASS=40
RQ4_REPAIR_MODELS="qwen2.5-coder:7b qwen2.5-coder:32b devstral:24b"
RQ4_REPAIR_N=200                                  # per model (600 total)
RQ4_NATURAL_N=150

# ── Ollama sizing for jobs that hold several models (coders, critics, judge) ─
AUX_NUM_PARALLEL=6                                # stages with one large model (rq4_builder): fits GPUS_RQ4_BUILDER
AUX_MAX_LOADED=3
# Parallel slots for the stages that keep SEVERAL models resident at num_ctx 32768 on the GPUs of the stage (GPUS_* above). KV cache grows
# with the slots (32B: ~8 GiB per slot, devstral ~5.4, 7B ~1.9), so 6 slots made the models evict each other
# (measured with hpc/slurm/90_check_gpu_sizing.sh). 2 slots keep every model of these stages resident; 3 slots left
# devstral + the 32B judge ~4 GiB short, so devstral was evicted.
AUX_PAR_RQ2LLM=2                                  # critics: qwen2.5-coder:32b + devstral:24b + qwen2.5-coder:7b
AUX_PAR_CODING=2                                  # coders: qwen2.5-coder:32b + devstral:24b
AUX_PAR_RQ4REF=2                                  # reference team model + the 32B judge
AUX_WORKERS=8

# ── Setup gates ──────────────────────────────────────────────────────────────
PREFLIGHT_MODEL="qwen2.5-coder:7b"
CANONICAL_MIN_CLASSEVAL=0.95                      # share of reference solutions that must pass the hidden tests
CANONICAL_MIN_HUMANEVAL=0.98
