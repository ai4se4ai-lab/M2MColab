-- The agenthot path for examples/06_baseline_comparison's toy task
-- (see run_agenthot() in run.py and README.md): the same vague user story
-- that run_freetext() and run_shared_schema() operate on, handled by a
-- real hybrid hand-off instead of raw LLM prose or a validated dict.
module Story2Arch;
create OUT : Arch from IN : Story;
uses 'helpers.py';

rule Epic2Component {
  from e : Story!Epic
  to  c : Arch!Component ( name <- e.name )
}

rule Story2Operation {
  from s : Story!UserStory
  to  op : Arch!Operation (
    id         <- s.id,
    name       <- s.id.toOpName(),
    component  <- s.epic,                 -- resolved via trace, not a copied string label
    constraint <- s.constraint,           -- structural: an exact copy, never seen by the LLM
    signature  <- @llm('Derive an API operation signature for this user story',
                        s.description),   -- footprint EXCLUDES the constraint on purpose
    @check signature.parses() )
}
