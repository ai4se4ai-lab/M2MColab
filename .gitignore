# --- Python / tooling ---
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

.env

# --- Benchmark caches ---
evaluation/benchmarks/cache/devbench/python/geotext/geotext/data_file/*
evaluation/benchmarks/cache/devbench/python/lice/templates/*

# --- AutoM2M ---
# Who&When dataset: external git clone (github.com/ag2ai/Agents_Failure_Attribution)
data/Agents_Failure_Attribution/

# Experiment outputs and logs (results/ is fully regenerated by evaluation/)
results/*
*.log

# Per-run team workdirs if pointed inside the repo (default is $TMPDIR)
am2m_*/

# agenthot workspaces created by `agenthot workspace init` / running examples
.agenthot/
*.json.tmp

# Generated by evaluation/analysis/analyze.py
docs/figures/
docs/tables/

# LaTeX build artifacts for docs/*.tex (docs/autom2m.pdf stays tracked: README links it)
docs/*.aux
docs/*.bbl
docs/*.bcf
docs/*.blg
docs/*.fdb_latexmk
docs/*.fls
docs/*.lof
docs/*.lot
docs/*.nav
docs/*.out
docs/*.run.xml
docs/*.snm
docs/*.synctex.gz
docs/*.toc
docs/*.vrb
docs/*.xdv
